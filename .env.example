# Stillpoint model configuration (local backend only).
# Copy to `.env` (never commit it) to enable AI-assisted mapping.
# The frontend never reads these values.
#
# Get a key from the Meta Model API dashboard, then run:
#   $env:MODEL_API_KEY = "<paste-key-here>"   # Windows PowerShell
#   export MODEL_API_KEY="<paste-key-here>"    # macOS / Linux
#   python -m backend.server
#
# Without MODEL_API_KEY the /api/analyze, /api/segment, and /api/chat
# endpoints answer 503 model_not_configured; the app falls back to manual
# mapping and the Guide reports AI as unavailable.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
SCENE_MODEL=muse-wonder-1.0
SEG_MODEL=sam-3.1
STILLPOINT_PORT=8787

# Paid TinEye reverse-image API; server only. Meta credentials do not enable search.
TINEYE_API_KEY=
